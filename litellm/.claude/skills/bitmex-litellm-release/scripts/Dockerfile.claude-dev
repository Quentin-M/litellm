FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl ripgrep jq less \
  && rm -rf /var/lib/apt/lists/*

# BitMEX CA so HTTPS to *.shared.global.bitmex verifies cleanly. Sourced from
# build context (build.sh stages it from a host path).
COPY bitmex-ca.crt /usr/local/share/ca-certificates/bitmex-ca.crt
RUN chmod 644 /usr/local/share/ca-certificates/bitmex-ca.crt && update-ca-certificates

# Latest Claude Code (tagged version pin recommended for reproducibility)
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

WORKDIR /work

ENTRYPOINT ["claude"]
